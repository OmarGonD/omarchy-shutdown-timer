#!/usr/bin/env bash
set -euo pipefail

PLUGIN_ID="io.github.omargond.shutdown-timer"
CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}
RUNTIME_HOME=${XDG_RUNTIME_DIR:-/tmp}
CONFIG_DIR="$CONFIG_HOME/shutdown-timer"
STATE_DIR="$STATE_HOME/shutdown-timer"
STATE_FILE="$STATE_DIR/state.json"
LOG_FILE="$STATE_DIR/events.log"
LOCK_FILE="$STATE_DIR/.lock"
SELF=$(readlink -f "$0")
WARNING_UNIT=shutdown-timer-warning.service
POWEROFF_UNIT=shutdown-timer-poweroff.service

die() { ensure_dirs 2>/dev/null || true; log_event "error=$*" 2>/dev/null || true; printf 'shutdown-timer: %s\n' "$*" >&2; exit 64; }
note() { printf '%s\n' "$*"; }
timestamp() { date -u '+%Y-%m-%dT%H:%M:%SZ'; }
now_epoch() { date +%s; }
ensure_dirs() { mkdir -p "$CONFIG_DIR" "$STATE_DIR"; }
config_value() {
  local key=$1 default=$2 value
  [[ -f "$CONFIG_DIR/config.ini" ]] || { printf '%s\n' "$default"; return; }
  value=$(awk -F= -v k="$key" '$1 == k {v=substr($0,index($0,"=")+1)} END {print v}' "$CONFIG_DIR/config.ini")
  printf '%s\n' "${value:-$default}"
}
max_hours() { config_value maximum_hours 168; }
grace_seconds() { config_value grace_period_seconds 600; }
notifications_enabled() { [[ $(config_value notifications true) == true ]]; }
log_event() { ensure_dirs; printf '%s\t%s\n' "$(timestamp)" "$*" >> "$LOG_FILE"; }
atomic_state() {
  local tmp="$STATE_DIR/.state.json.tmp.$$"
  ensure_dirs; printf '%s\n' "$1" > "$tmp"; mv -f -- "$tmp" "$STATE_FILE"
}
with_lock() {
  ensure_dirs
  # flock releases automatically when this shell exits, so a crashed or
  # interrupted invocation cannot leave a stale directory blocking future use.
  exec 9>"$LOCK_FILE"
  flock -n 9 || die 'hay otra operación en curso; inténtalo de nuevo'
  "$@"
}
notify() {
  notifications_enabled || return 0
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send --app-name='Shutdown Timer' "$1" "$2" >/dev/null 2>&1 || true
}
validate_duration() {
  local raw=$1 number unit seconds
  [[ $raw =~ ^([0-9]+([.][0-9]+)?)(m|h)$ ]] || die "duración inválida: '$raw' (usa 30m, 1h o 2.5h)"
  number=${BASH_REMATCH[1]}; unit=${BASH_REMATCH[3]}
  awk -v n="$number" 'BEGIN {exit !(n > 0)}' || die 'la duración debe ser mayor que cero'
  if [[ $unit == h ]]; then
    awk -v n="$number" -v m="$(max_hours)" 'BEGIN {exit !(n <= m)}' || die "la duración supera el máximo de $(max_hours) horas"
    seconds=$(awk -v n="$number" 'BEGIN {printf "%d", n*3600+0.5}')
  else
    awk -v n="$number" -v m="$(max_hours)" 'BEGIN {exit !(n <= m*60)}' || die "la duración supera el máximo de $(max_hours) horas"
    seconds=$(awk -v n="$number" 'BEGIN {printf "%d", n*60+0.5}')
  fi
  (( seconds > 0 )) || die 'la duración debe ser mayor que cero'
  printf '%s\n' "$seconds"
}
format_duration() {
  local s=$1
  if ((s % 3600 == 0)); then printf '%dh' "$((s/3600))"
  elif ((s % 60 == 0)); then printf '%dm' "$((s/60))"
  else printf '%dm %ds' "$((s/60))" "$((s%60))"; fi
}
format_remaining() {
  local s=$1
  if ((s >= 3600)); then printf '%dh %02dm' "$((s/3600))" "$(((s%3600)/60))"
  elif ((s >= 60)); then printf '%dm %02ds' "$((s/60))" "$((s%60))"
  else printf '%ds' "$s"; fi
}
pretty_date() { date '+%Y-%m-%d %H:%M:%S %Z' -d "@$1"; }
action_label() { case "$1" in poweroff) echo apagado ;; reboot) echo reinicio ;; suspend) echo suspensión ;; hibernate) echo hibernación ;; lock) echo bloqueo ;; logout) echo "cierre de sesión" ;; esac; }
validate_action() {
  case "$1" in poweroff|reboot|suspend|hibernate|lock|logout) printf '%s\n' "$1" ;; *) die "acción inválida: '$1' (usa poweroff, reboot, suspend, hibernate, lock o logout)" ;; esac
}
write_state() {
  local mode=$1 raw=$2 seconds=$3 target=$4 action=$5
  atomic_state "$(jq -cn --arg c "$(timestamp)" --arg d "$raw" --argjson s "$seconds" --argjson t "$target" --arg w "$WARNING_UNIT" --arg p "$POWEROFF_UNIT" --arg m "$mode" --arg a "$action" '{created_at:$c,duration:$d,duration_seconds:$s,target_epoch:$t,target_at:($t|todateiso8601),warning_unit:$w,poweroff_unit:$p,action:$a,mode:$m,status:"scheduled"}')"
}
units_active() { systemctl --user is-active --quiet "${WARNING_UNIT%.service}.timer" "${POWEROFF_UNIT%.service}.timer" "$WARNING_UNIT" "$POWEROFF_UNIT"; }
clear_units() {
  # Timers must stop too: stopping only a service leaves its trigger armed.
  systemctl --user stop "${WARNING_UNIT%.service}.timer" "${POWEROFF_UNIT%.service}.timer" "$WARNING_UNIT" "$POWEROFF_UNIT" >/dev/null 2>&1 || true
  systemctl --user reset-failed "${WARNING_UNIT%.service}.timer" "${POWEROFF_UNIT%.service}.timer" "$WARNING_UNIT" "$POWEROFF_UNIT" >/dev/null 2>&1 || true
}
cleanup_stale() {
  [[ -f "$STATE_FILE" ]] || return 0
  local status target
  status=$(jq -r '.status // ""' "$STATE_FILE" 2>/dev/null || true)
  target=$(jq -r '.target_epoch // 0' "$STATE_FILE" 2>/dev/null || true)
  if [[ $status == scheduled && $target =~ ^[0-9]+$ ]] && ((target < $(now_epoch))) && ! units_active; then
    log_event "stale_state_removed target_epoch=$target"; rm -f -- "$STATE_FILE"
  fi
}
choose_existing() {
  local answer
  [[ -t 0 ]] || return 2
  read -r -p 'Ya existe un apagado programado [r=reemplazar, c=conservar, x=cancelar]: ' answer
  case "$answer" in r|R) return 0 ;; c|C) return 1 ;; *) return 2 ;; esac
}
schedule_locked() {
  local raw=$1 dry=$2 replace=$3 seconds target warning_delay old_status
  seconds=$(validate_duration "$raw"); cleanup_stale
  if [[ $YES != true && $(config_value confirm_before_scheduling true) == true && -t 0 ]]; then
    local confirmation
    read -r -p "Programar apagado en $(format_duration "$seconds")? [s/N] " confirmation
    [[ $confirmation == [sS] ]] || { note 'Operación cancelada.'; return 0; }
  fi
  old_status=$(jq -r '.status // ""' "$STATE_FILE" 2>/dev/null || true)
  if [[ $dry == true && $old_status == scheduled && $(jq -r '.mode // "live"' "$STATE_FILE") == live ]]; then
    die 'modo dry-run no modifica un temporizador real; usa shutdown-timer cancel sin --dry-run'
  fi
  if [[ $old_status == scheduled ]]; then
    case "$replace" in replace) clear_units; log_event 'replaced_existing_timer=true' ;; keep) note 'Se conserva el temporizador existente.'; return 0 ;; cancel) note 'Operación cancelada.'; return 0 ;; *) choose_existing && { clear_units; log_event 'replaced_existing_timer=true'; } || { note 'Operación cancelada o conservada.'; return 0; } ;; esac
  fi
  target=$(( $(now_epoch) + seconds )); warning_delay=$((seconds - $(grace_seconds))); ((warning_delay < 1)) && warning_delay=1
  if [[ $dry == true ]]; then
    write_state simulation "$raw" "$seconds" "$target" "$ACTION"
    log_event "dry_run_scheduled duration=$raw target_epoch=$target"
    note "SIMULACIÓN: habría creado $WARNING_UNIT (--on-active=${warning_delay}s) y $POWEROFF_UNIT (--on-active=${seconds}s)."
    note "SIMULACIÓN: el servicio final ejecutaría la acción: $ACTION"
    note "SIMULACIÓN: notificación final prevista para $(pretty_date "$target")."
  else
    clear_units
    if ! systemd-run --user --unit="$WARNING_UNIT" --on-active="${warning_delay}s" --timer-property=AccuracySec=1s --collect -- "$SELF" --internal-warning ||
       ! systemd-run --user --unit="$POWEROFF_UNIT" --on-active="${seconds}s" --collect -- "$SELF" --internal-poweroff; then
      clear_units
      if [[ -f "$STATE_FILE" ]]; then
        atomic_state "$(jq '.status="cancelled"' "$STATE_FILE")"
      fi
      die 'no se pudo crear el temporizador; se limpiaron las unidades incompletas'
    fi
    write_state live "$raw" "$seconds" "$target" "$ACTION"
    log_event "scheduled duration=$raw target_epoch=$target warning_unit=$WARNING_UNIT poweroff_unit=$POWEROFF_UNIT"
  fi
  note "Programado ($(action_label "$ACTION")) para: $(pretty_date "$target")"
  note "Tiempo restante: $(format_duration "$seconds")"
  note 'Cancela con: shutdown-timer cancel'
  notify "Programado: $(action_label "$ACTION")" "Faltan $(format_duration "$seconds"). Hora prevista: $(pretty_date "$target"). Cancela con shutdown-timer cancel."
}
schedule_cmd() { with_lock schedule_locked "$@"; }
status_cmd() {
  cleanup_stale
  local short=${1:-false}
  if [[ ! -f "$STATE_FILE" || $(jq -r '.status // ""' "$STATE_FILE") != scheduled ]]; then
    [[ $short == true ]] || note 'No hay ningún apagado programado.'
    return 0
  fi
  local mode target duration unit action left
  mode=$(jq -r '.mode // "live"' "$STATE_FILE"); target=$(jq -r '.target_epoch' "$STATE_FILE")
  duration=$(jq -r '.duration' "$STATE_FILE"); unit=$(jq -r '.poweroff_unit' "$STATE_FILE"); action=$(jq -r '.action // "poweroff"' "$STATE_FILE")
  left=$((target - $(now_epoch))); ((left < 0)) && left=0
  if [[ $short == true ]]; then format_remaining "$left"; return 0; fi
  [[ $mode == simulation ]] && mode='SIMULACIÓN' || mode='ACTIVO'
  printf '%s: scheduled\nAcción: %s\nDuración: %s\nRestante: %s\nPrevisto: %s\nServicio: %s\n' "$mode" "$(action_label "$action")" "$duration" "$(format_remaining "$left")" "$(pretty_date "$target")" "$unit"
}
cancel_locked() {
  cleanup_stale
  [[ -f "$STATE_FILE" ]] || { note 'No hay ningún apagado programado.'; return 0; }
  local mode; mode=$(jq -r '.mode // "live"' "$STATE_FILE")
  if [[ $DRY == true && $mode == live ]]; then
    note 'SIMULACIÓN: no se cancela un temporizador real.'
    return 0
  fi
  if [[ $(config_value confirm_before_canceling false) == true && -t 0 ]]; then
    local confirmation
    read -r -p '¿Cancelar el apagado programado? [s/N] ' confirmation
    [[ $confirmation == [sS] ]] || { note 'Cancelación rechazada.'; return 0; }
  fi
  clear_units
  jq '.status="cancelled"' "$STATE_FILE" > "$STATE_DIR/.cancelled.$$"; mv -f -- "$STATE_DIR/.cancelled.$$" "$STATE_FILE"
  log_event "cancelled mode=$mode"; [[ $mode == simulation ]] && mode='SIMULACIÓN' || mode='ACTIVO'; note "$mode: apagado cancelado."; notify 'Apagado cancelado' 'El temporizador ya no actuará sobre la PC.'
}
extend_locked() {
  local raw=$1 seconds old_target new_target left mode action
  seconds=$(validate_duration "$raw"); cleanup_stale
  [[ -f "$STATE_FILE" && $(jq -r '.status // ""' "$STATE_FILE") == scheduled ]] || die 'no hay ningún temporizador que extender'
  mode=$(jq -r '.mode // "live"' "$STATE_FILE"); action=$(jq -r '.action // "poweroff"' "$STATE_FILE")
  if [[ $DRY == true && $mode == live ]]; then note 'SIMULACIÓN: no se extiende un temporizador real.'; return 0; fi
  old_target=$(jq -r '.target_epoch' "$STATE_FILE"); new_target=$((old_target + seconds)); left=$((new_target - $(now_epoch)))
  ((left <= 0)) && die 'el temporizador ya expiró'
  ((left <= $(max_hours) * 3600)) || die "el total supera el máximo de $(max_hours) horas"
  if [[ $mode == live ]]; then
    local warning_delay=$((left - $(grace_seconds))); ((warning_delay < 1)) && warning_delay=1
    clear_units
    if ! systemd-run --user --unit="$WARNING_UNIT" --on-active="${warning_delay}s" --timer-property=AccuracySec=1s --collect -- "$SELF" --internal-warning ||
       ! systemd-run --user --unit="$POWEROFF_UNIT" --on-active="${left}s" --collect -- "$SELF" --internal-poweroff; then
      clear_units
      die 'no se pudo extender el temporizador; se limpiaron las unidades'
    fi
  fi
  write_state "$mode" "$(jq -r '.duration' "$STATE_FILE")+$raw" "$left" "$new_target" "$action"
  log_event "extended by=$raw target_epoch=$new_target"
  note "Extendido $raw. Nuevo objetivo: $(pretty_date "$new_target") (restan $(format_remaining "$left"))"
  notify 'Temporizador extendido' "Nueva hora prevista: $(pretty_date "$new_target")."
}
extend_cmd() { with_lock extend_locked "$1"; }
cancel_cmd() { with_lock cancel_locked; }
internal_warning() {
  [[ -f "$STATE_FILE" ]] || return 0
  [[ $(jq -r '.status' "$STATE_FILE") == scheduled && $(jq -r '.mode' "$STATE_FILE") == live ]] || return 0
  local remaining minutes
  remaining=$(( $(jq -r '.target_epoch' "$STATE_FILE") - $(now_epoch) ))
  (( remaining > 0 )) || return 0
  minutes=$(( (remaining + 59) / 60 ))
  log_event "warning_remaining_seconds=$remaining"
  local action; action=$(jq -r '.action // "poweroff"' "$STATE_FILE")
  notify "$(action_label "$action") en $minutes min" "Acción programada ($(action_label "$action")) en $minutes min. Guarda tu trabajo. Puedes editar o cancelar desde Shutdown Timer."
}
poweroff_command() {
  case "$1" in
    lock) omarchy-system-lock ;;
    logout) omarchy-system-logout ;;
    *) systemctl "$1" ;;
  esac
}
internal_poweroff() {
  [[ -f "$STATE_FILE" ]] || exit 0
  [[ $(jq -r '.status // ""' "$STATE_FILE") == scheduled ]] || exit 0
  local action; action=$(jq -r '.action // "poweroff"' "$STATE_FILE")
  jq '.status="powering_off"' "$STATE_FILE" > "$STATE_DIR/.powering.$$"; mv -f -- "$STATE_DIR/.powering.$$" "$STATE_FILE"
  log_event "action_requested=$action"; poweroff_command "$action"
}
show_logs() { [[ -f "$LOG_FILE" ]] && cat "$LOG_FILE" || note 'No hay eventos registrados.'; }
show_config() {
  ensure_dirs
  if [[ ! -f "$CONFIG_DIR/config.ini" ]]; then
    cat > "$CONFIG_DIR/config.ini" <<'EOF'
grace_period_seconds=600
notifications=true
maximum_hours=168
confirm_before_scheduling=true
confirm_before_canceling=false
EOF
  fi
  cat "$CONFIG_DIR/config.ini"
}
usage() { cat <<'EOF'
Uso: shutdown-timer [OPCIÓN] COMANDO
Duraciones directas: 30m, 45m, 1h, 3h, 4h
Comandos: schedule DURACIÓN | extend DURACIÓN | status [--short] | cancel | menu | logs | config
Opciones: --action poweroff|reboot|suspend|hibernate|lock|logout, --dry-run, --replace, --keep, --yes, --help
EOF
}
DRY=false; REPLACE=''; YES=false; ACTION=poweroff
while (($#)); do case "$1" in --dry-run) DRY=true; shift ;; --replace) REPLACE=replace; shift ;; --keep) REPLACE=keep; shift ;; --cancel) REPLACE=cancel; shift ;; --yes|-y) YES=true; shift ;; --action) [[ $# -ge 2 ]] || die 'falta valor para --action'; ACTION=$(validate_action "$2"); shift 2 ;; --action=*) ACTION=$(validate_action "${1#*=}"); shift ;; --internal-warning) internal_warning; exit ;; --internal-poweroff) internal_poweroff; exit ;; -h|--help) usage; exit 0 ;; *) break ;; esac; done
command_name=${1:-menu}; shift || true
case "$command_name" in
  30m|45m|1h|3h|4h|*m|*h) [[ $# -eq 0 ]] || die 'argumentos inesperados'; schedule_cmd "$command_name" "$DRY" "$REPLACE" ;;
  schedule) [[ $# -eq 1 ]] || die 'uso: shutdown-timer schedule DURACIÓN'; schedule_cmd "$1" "$DRY" "$REPLACE" ;;
  status) case "${1:-}" in '') status_cmd false ;; --short) status_cmd true ;; *) die 'uso: shutdown-timer status [--short]' ;; esac ;;
  extend) [[ $# -eq 1 ]] || die 'uso: shutdown-timer extend DURACIÓN'; extend_cmd "$1" ;;
  cancel) [[ $# -eq 0 ]] || die 'uso: shutdown-timer cancel'; cancel_cmd ;;
  menu) [[ $# -eq 0 ]] || die 'uso: shutdown-timer menu'; exec omarchy-shell shell summon "$PLUGIN_ID" '{}' ;;
  logs) [[ $# -eq 0 ]] || die 'uso: shutdown-timer logs'; show_logs ;;
  config) [[ $# -eq 0 ]] || die 'uso: shutdown-timer config'; show_config ;;
  *) die "comando o duración desconocidos: '$command_name'" ;;
esac
